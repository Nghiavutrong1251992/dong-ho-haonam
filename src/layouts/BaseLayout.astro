---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteOrigin = Astro.site?.toString() ?? 'https://haonamwatchcare.com';
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const logoUrl = new URL('/logo.webp', siteOrigin).toString();

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  description: SITE.description,
  logo: logoUrl,
  image: logoUrl,
  telephone: '+84902286886',
  url: siteOrigin,
  sameAs: [SITE.facebookHref],
  priceRange: '$$$',
  areaServed: ['VN', 'International'],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="vi_VN" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingActions />
  </body>
</html>
