---
import { NAV_ITEMS, SITE } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={SITE.name}>
      <img
        src="/logo.webp"
        alt={SITE.name}
        width="72"
        height="72"
        class="brand__logo"
        decoding="async"
        fetchpriority="high"
      />
      <span class="brand__text">
        <span class="brand__name">{SITE.name}</span>
        <span class="brand__sub">Luxury Watch Repair</span>
      </span>
    </a>

    <nav class="nav" aria-label="Menu chính">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-active': currentPath.startsWith(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a href={SITE.zaloHref} target="_blank" rel="noopener noreferrer" class="btn btn--outline header-zalo">
        Zalo: {SITE.phoneDisplay}
      </a>
      <a href="/lien-he/#dat-lich" class="btn btn--primary">Đặt lịch kiểm tra</a>
    </div>

    <button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false" id="menu-toggle">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="container mobile-nav__inner">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class="mobile-nav__link">{item.label}</a>
      ))}
      <div class="mobile-nav__cta">
        <a href="/lien-he/#dat-lich" class="btn btn--primary">Đặt lịch kiểm tra</a>
        <a href={SITE.zaloHref} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
          Nhắn Zalo: {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const isOpen = !mobileNav.hasAttribute('hidden');
      if (isOpen) {
        mobileNav.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(247, 245, 240, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 92px;
    padding: 0.4rem 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    line-height: 1.15;
  }

  .brand__logo {
    width: 72px;
    height: 72px;
    border-radius: var(--radius);
    object-fit: cover;
    border: 1px solid var(--gold);
    flex-shrink: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
  }

  .brand__name {
    font-family: var(--font-serif);
    font-size: 1.22rem;
    font-weight: 700;
    color: var(--ink);
  }

  .brand__sub {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav__link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-muted);
    transition: color 0.15s ease;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link.is-active {
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .header-actions .btn {
    padding: 0.6rem 1rem;
    font-size: 0.86rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.55rem;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 20px;
    height: 2px;
    background: var(--ink);
    display: block;
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 1rem 0 1.5rem;
  }

  .mobile-nav__inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav__link {
    padding: 0.45rem 0;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav__cta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 1024px) {
    .header-zalo {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .header-inner {
      min-height: 76px;
    }

    .brand__logo {
      width: 56px;
      height: 56px;
    }

    .nav,
    .header-actions {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>
