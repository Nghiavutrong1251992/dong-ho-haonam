---
import { SITE } from '../data/site';
---

<div class="floating-actions" aria-label="Hỗ trợ nhanh">
  <a
    href={SITE.zaloHref}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-btn floating-btn--accent"
    aria-label="Chat Zalo"
    title={`Zalo: ${SITE.phoneDisplay}`}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      <path d="M8.5 9.5h7l-7 5h7" />
    </svg>
  </a>

  <a
    href={SITE.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-btn"
    aria-label="Chat WhatsApp"
    title={`WhatsApp: ${SITE.phoneDisplay}`}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z" />
      <path d="M9.5 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c.5.9 1.2 1.6 2.1 2.1l.6-.5c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.2.6-.5.7-.7.3-1.8.2-3.4-.6-1.6-.8-2.9-2.2-3.7-3.7-.7-1.4-.9-2.5-.5-3.2z" />
    </svg>
  </a>

  <button
    type="button"
    id="back-to-top"
    class="floating-btn floating-btn--top"
    aria-label="Lên đầu trang"
    title="Lên đầu trang"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 15l-6-6-6 6" />
    </svg>
  </button>
</div>

<script>
  const backToTopBtn = document.getElementById('back-to-top');
  if (backToTopBtn) {
    const toggleVisibility = () => {
      if (window.scrollY > 280) {
        backToTopBtn.classList.add('is-visible');
      } else {
        backToTopBtn.classList.remove('is-visible');
      }
    };

    window.addEventListener('scroll', toggleVisibility, { passive: true });
    toggleVisibility();

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
