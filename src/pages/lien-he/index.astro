---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import { SITE } from '../../data/site';
---

<BaseLayout
  title={`Liên hệ & Đặt lịch kiểm tra — ${SITE.name}`}
  description={`Liên hệ trực tiếp với Hào Nam qua SĐT/Zalo/WhatsApp ${SITE.phoneDisplay} hoặc Facebook để được tư vấn kiểm tra, bảo dưỡng và sửa chữa đồng hồ cao cấp.`}
>
  <section class="section section--surface">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a> / <span>Liên hệ</span>
      </nav>

      <div class="section__header">
        <span class="eyebrow">Liên hệ trực tiếp</span>
        <h1 class="font-serif" style="font-size: clamp(2rem, 3.3vw, 2.7rem);">Đặt lịch kiểm tra & gửi ảnh tư vấn</h1>
        <p class="lead">
          Cách nhanh nhất là nhắn trực tiếp cho tôi qua Zalo hoặc WhatsApp kèm ảnh mặt đồng hồ và mô tả tình trạng đang gặp.
        </p>
      </div>

      <div class="contact-grid">
        <div class="card">
          <h2 class="font-serif" style="font-size: 1.5rem;">Thông tin liên hệ</h2>
          <ul class="contact-list">
            <li>
              <span>Thợ kỹ thuật trực tiếp:</span>
              <strong>{SITE.owner} ({SITE.name})</strong>
            </li>
            <li>
              <span>Điện thoại / Zalo:</span>
              <a href={SITE.phoneHref}><strong>{SITE.phoneDisplay}</strong></a>
            </li>
            <li>
              <span>WhatsApp:</span>
              <a href={SITE.whatsappHref} target="_blank" rel="noopener noreferrer"><strong>+84 902 286 886</strong></a>
            </li>
            <li>
              <span>Facebook:</span>
              <a href={SITE.facebookHref} target="_blank" rel="noopener noreferrer"><strong>{SITE.facebookLabel}</strong></a>
            </li>
            <li>
              <span>Thời gian làm việc:</span>
              <strong>{SITE.hours}</strong>
            </li>
          </ul>

          <div style="margin-top: 1.25rem;">
            <SocialIcons />
          </div>

          <div style="margin-top: 1.75rem;">
            <ImageSlot
              ratio="16/9"
              label="Ảnh cửa hàng / Bản đồ chỉ đường"
              note="Chèn ảnh mặt tiền cửa hàng hoặc bản đồ Google Maps khi hoàn thiện địa chỉ"
            />
          </div>
        </div>

        <div class="card" id="dat-lich">
          <h2 class="font-serif" style="font-size: 1.5rem;">Gửi thông tin đặt lịch</h2>
          <p class="card__meta">
            Điền nhanh thông tin bên dưới, hệ thống sẽ tạo sẵn nội dung để bạn gửi trực tiếp qua WhatsApp hoặc Zalo cho tôi.
          </p>

          <form id="booking-form" class="booking-form">
            <label>
              <span>Tên của bạn</span>
              <input type="text" name="name" required placeholder="Ví dụ: Anh Minh" />
            </label>

            <label>
              <span>Số điện thoại / Zalo</span>
              <input type="tel" name="phone" required placeholder="09xx xxx xxx" />
            </label>

            <label>
              <span>Thương hiệu & mẫu đồng hồ</span>
              <input type="text" name="watch" required placeholder="Ví dụ: Rolex Datejust 36, Omega Seamaster..." />
            </label>

            <label>
              <span>Tình trạng hiện tại</span>
              <textarea
                name="issue"
                rows="4"
                required
                placeholder="Ví dụ: Đồng hồ chạy chậm, bị hấp hơi nước hoặc cần lau dầu định kỳ..."
              ></textarea>
            </label>

            <div class="btn-group">
              <button type="submit" class="btn btn--primary">Gửi qua WhatsApp</button>
              <a href={SITE.zaloHref} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
                Mở Zalo ({SITE.phoneDisplay})
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '');
      const phone = String(data.get('phone') || '');
      const watch = String(data.get('watch') || '');
      const issue = String(data.get('issue') || '');

      const text = `Chào Hào Nam Watch Care,\nTên: ${name}\nSĐT/Zalo: ${phone}\nĐồng hồ: ${watch}\nTình trạng: ${issue}`;
      const url = `https://wa.me/84902286886?text=${encodeURIComponent(text)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .contact-list span {
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .contact-list a {
    color: var(--gold);
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .booking-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .booking-form input,
  .booking-form textarea {
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
  }

  .booking-form input:focus,
  .booking-form textarea:focus {
    outline: 2px solid var(--gold);
    border-color: transparent;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
